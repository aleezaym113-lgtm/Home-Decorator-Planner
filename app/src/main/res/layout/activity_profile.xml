<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal"
    android:background="#EEF2F7">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="👤" android:textSize="64sp" android:layout_marginTop="36dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="My Profile" android:textSize="28sp" android:textStyle="bold"
        android:textColor="#173C8C" android:layout_marginTop="12dp"/>
    <EditText android:id="@+id/etName" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="24dp" android:padding="12dp"
        android:background="@drawable/input_background" android:hint="Full name"
        android:inputType="textPersonName"/>
    <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="12dp" android:padding="12dp"
        android:background="@drawable/input_background" android:hint="Email"
        android:inputType="textEmailAddress"/>
    <Button android:id="@+id/btnSaveProfile" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="16dp"
        android:text="Save Profile" android:textAllCaps="false"/>
    <Button android:id="@+id/btnHome" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="10dp"
        android:text="Back to Home" android:textAllCaps="false"/>
</LinearLayout>
