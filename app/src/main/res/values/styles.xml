<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#2457C5</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#173C8C</item>
        <item name="android:navigationBarColor">#173C8C</item>
    </style>
    <style name="ModuleCard">
        <item name="android:layout_width">155dp</item>
        <item name="android:layout_height">115dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#173C8C</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
